// -*- mode: jsonc -*-
{
    "position": "bottom",
    "height": 30,
    "spacing": 6,
    "modules-left": [
        "sway/workspaces",
        "sway/window",
        "sway/mode",
        "sway/scratchpad"
    ],
    "modules-center": [],
    "modules-right": [
        "custom/net-ip",
        "custom/disks",
        "cpu",
        "memory",
        "temperature",
        "clock#time",
        "clock#date",
        "pulseaudio",
        "custom/blue-light",
        "idle_inhibitor",
        "battery",
        "power-profiles-daemon",
        "tray"
    ],
    "sway/workspaces": {
        "all-outputs": false,
        "format": "{icon} {name}",
        "format-icons": {
            "urgent": "",
            "focused": "",
            "default": ""
        }
    },
    "sway/window": {
        "max-length": 96,
        "icon": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": " $1",
            "(.*) - Google Chrome": " $1",
            "(.*) - Chromium": " $1",
            "(.*) — Discord": " $1",
            "(.*)Telegram(.*)": " $1"
        }
    },
    "custom/net-ip": {
        "return-type": "json",
        "exec": "$HOME/.config/waybar/net-cycle.sh",
        "interval": 5,
        "signal": 30,
        "on-click": "$HOME/.config/waybar/net-cycle.sh cycle; pkill -RTMIN+30 waybar",
        "format": "{text}",
        "tooltip": true
    },
    "custom/disks": {
        "return-type": "json",
        "exec": "$HOME/.config/waybar/disk-mounts.sh",
        "interval": 45,
        "signal": 31,
        "on-click": "$HOME/.config/waybar/disk-mounts.sh cycle; pkill -RTMIN+31 waybar",
        "format": " {text}",
        "tooltip": true,
        "escape": false
    },
    "sway/mode": {
        "format": " <span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "custom/blue-light": {
        "return-type": "json",
        "exec": "$HOME/.config/waybar/blue-light.sh",
        "interval": 60,
        "signal": 8,
        "on-click": "$HOME/.config/waybar/blue-light.sh cycle; pkill -RTMIN+8 waybar",
        "format": "{text}",
        "tooltip": true
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        "spacing": 10
    },
    "clock#time": {
        "format": " {:%H:%M}",
        "tooltip-format": "<big>{:%Y-%m-%d %A}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "clock#date": {
        "format": " {:%Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": " {usage}%",
        "interval": 3,
        "tooltip": false
    },
    "memory": {
        "format": " {percentage}%",
        "tooltip-format": "{used:human} / {total:human}"
    },
    "temperature": {
        "critical-threshold": 85,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": " {icon} {volume}%",
        "format-muted": " mute",
        "format-source-muted": " mute",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "tooltip-format": "{desc}"
    },
    "battery": {
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-time": "{H}:{m}",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{capacity}% · {time}\n{power} W"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    }
}
