# Endpoints for the Waybar strength control.
# 0% is WLSUNSET_HIGH (neutral daylight). 100% is WLSUNSET_LOW (warmest, least blue).
WLSUNSET_LOW=4000
WLSUNSET_HIGH=6500

# wlsunset still needs a clock or a location, even when both temperatures are equal.
WLSUNSET_SUNRISE=06:30
WLSUNSET_SUNSET=19:30
WLSUNSET_DURATION=1800

# Optional. If both are set, they are passed through instead of the clock times above.
# WLSUNSET_LAT=
# WLSUNSET_LON=
